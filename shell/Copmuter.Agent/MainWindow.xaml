<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Copmuter.Agent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Copmuter.Agent.Converters"
    Title="Copmuter — локальный компьютерный агент">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <conv:MessageBrushConverter x:Key="MessageBrush" />
            <conv:MessageAlignConverter x:Key="MessageAlign" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Padding="16,12,16,8" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Copmuter" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="локальный агент: C++ ядро + Qwen3-VL" Opacity="0.6"
                       VerticalAlignment="Center" />
            <ToggleSwitch x:Name="SettingsToggle" Header="" OnContent="Настройки"
                          OffContent="Настройки" Toggled="OnSettingsToggled" />
            <ToggleSwitch Header="" OnContent="PLAN ONLY" OffContent="PLAN ONLY"
                          IsOn="{x:Bind ViewModel.Settings.PlanOnly, Mode=TwoWay}" />
        </StackPanel>

        <!-- Чат -->
        <Grid Grid.Row="1" Grid.Column="0" Padding="16,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="ChatList" Grid.Row="0" ItemsSource="{x:Bind ViewModel.Messages}"
                      SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage"
                                  xmlns:models="using:Copmuter.Agent.Models">
                        <Border Margin="0,3" Padding="10,7" CornerRadius="8"
                                MaxWidth="620"
                                HorizontalAlignment="{Binding Role, Converter={StaticResource MessageAlign}}"
                                Background="{Binding Role, Converter={StaticResource MessageBrush}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="White" />
                                <TextBlock Text="{Binding Time}" FontSize="11" Opacity="0.5"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="1" ColumnSpacing="8" Padding="0,8,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0" PlaceholderText="Скажи, что сделать…"
                         Text="{x:Bind ViewModel.Input, Mode=TwoWay}"
                         KeyDown="OnInputKeyDown" />
                <Button Grid.Column="1" Content="Отправить" Style="{StaticResource AccentButtonStyle}"
                        Click="OnSendClick"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                <Button Grid.Column="2" Content="Стоп" Click="OnStopClick" />
            </Grid>
        </Grid>

        <!-- Настройки -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Width="320" Padding="12"
                      Visibility="{x:Bind SettingsToggle.IsOn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="10">
                <TextBlock Text="Настройки" FontWeight="SemiBold" />

                <TextBlock Text="Каталог данных" />
                <TextBox Text="{x:Bind ViewModel.Settings.StateDir, Mode=TwoWay}" />

                <TextBlock Text="Канал к мозгу (Named Pipe)" />
                <TextBox Text="{x:Bind ViewModel.Settings.SocketPath, Mode=TwoWay}" />

                <TextBlock Text="Путь к Python" />
                <TextBox Text="{x:Bind ViewModel.Settings.PythonPath, Mode=TwoWay}" />

                <TextBlock Text="Каталог проекта (корень репозитория)" />
                <TextBox Text="{x:Bind ViewModel.Settings.RepoRoot, Mode=TwoWay}" />

                <TextBlock Text="Режим безопасности" />
                <ComboBox SelectedValue="{x:Bind ViewModel.Settings.SafetyMode, Mode=TwoWay}"
                          SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Полный доступ" Tag="full" />
                    <ComboBoxItem Content="Авто (опасное — с подтверждением)" Tag="auto" />
                    <ComboBoxItem Content="Подтверждать всё" Tag="confirm" />
                    <ComboBoxItem Content="Пошагово" Tag="step" />
                    <ComboBoxItem Content="Наблюдение" Tag="observe" />
                    <ComboBoxItem Content="Только план" Tag="plan_only" />
                </ComboBox>

                <TextBlock Text="Браузер по умолчанию" />
                <TextBox Text="{x:Bind ViewModel.Settings.DefaultBrowser, Mode=TwoWay}" />

                <ToggleSwitch Header="Предзагрузка при старте (поиск приложений, проверка модели)"
                              IsOn="{x:Bind ViewModel.Settings.Preload, Mode=TwoWay}" />

                <TextBlock Text="Таймаут запуска, мс" />
                <NumberBox Value="{x:Bind ViewModel.Settings.LaunchTimeoutMs, Mode=TwoWay}"
                           SpinButtonPlacementMode="Compact" />

                <TextBlock Text="Таймаут зрения, мс" />
                <NumberBox Value="{x:Bind ViewModel.Settings.VisionTimeoutMs, Mode=TwoWay}"
                           SpinButtonPlacementMode="Compact" />

                <TextBlock Text="Повторы при сбое" />
                <NumberBox Value="{x:Bind ViewModel.Settings.MaxRetries, Mode=TwoWay}"
                           SpinButtonPlacementMode="Compact" />

                <TextBlock Text="Профилировщик (Time To Completion — главная метрика)"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Metrics, Mode=OneWay}" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="11" Opacity="0.8" />
            </StackPanel>
        </ScrollViewer>

        <!-- Строка состояния -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="16,6" Background="#1AFFFFFF">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
