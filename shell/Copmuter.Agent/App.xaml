<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Copmuter.Agent.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- One shipped design. Native control templates preserve keyboard/focus states. -->
            <FontFamily x:Key="AppFont">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
            <SolidColorBrush x:Key="ScrimBrush" Color="#09191D" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#9912252A" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#800B1C21" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TextBrush" Color="#F1F7F6" />
            <SolidColorBrush x:Key="DimBrush" Color="#B1C5C7" />
            <SolidColorBrush x:Key="FaintBrush" Color="#91A7AB" />
            <SolidColorBrush x:Key="AccentBrush" Color="#63DAC8" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#082822" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1863DAC8" />
            <SolidColorBrush x:Key="ErrBrush" Color="#FFA3AC" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#63DAC8" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#63DAC8" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F012252A" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#63DAC8" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#91A7AB" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#F1F7F6" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#10282E" />
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SettingsGroup" TargetType="Border">
                <Setter Property="Padding" Value="24" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
